model Ticket {
  id             Int            @id @default(autoincrement())
  ticketNumber   String         @unique @map("ticket_number") @db.VarChar(50)
  categoryId     Int            @map("category_id")
  description    String         @db.Text
  estimateAmount Decimal        @map("estimate_amount") @db.Decimal(12, 2)
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(PENDING)
  deadline       DateTime       @db.DateTime(0)
  requestedBy    String         @map("requested_by") @db.Char(36) // Plain foreign key reference to users.id
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  category      TicketCategory        @relation(fields: [categoryId], references: [id])
  attachments   TicketAttachment[]
  statusHistory TicketStatusHistory[]
  payment       TicketPayment?

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([deadline])
  @@index([requestedBy])
  @@map("tickets")
}
